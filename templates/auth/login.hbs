<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Sistema de Seguridad - Autenticación</title>
    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
    <div class="card" style="width: 100%; max-width: 400px;">
        <h2 style="text-align: center; color: #60a5fa;">Control de Seguridad</h2>
        <form id="login-form">
            <label>Correo Electrónico:</label>
            <input type="email" id="email" class="form-control" required placeholder="guardia@empresa.cl">
            
            <label>Contraseña:</label>
            <input type="password" id="password" class="form-control" required placeholder="******">
            
            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
            <p style="text-align: center; margin-top: 15px;">
                <a href="/register" style="color: #60a5fa; text-decoration: none;">¿No tienes cuenta? Regístrate aquí</a>
            </p>
        </form>
    </div>

    <script>
        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value
                })
            });
            const data = await res.json();
            if(data.ok) {
                window.location.href = '/dashboard';
            } else {
                alert(data.mensaje);
            }
        });
    </script>
</body>
</html>